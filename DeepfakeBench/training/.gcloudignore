# .gcloudignore
# ────────────────────────────────────────────────────────────────
# Exclude files from `gcloud builds submit` source upload.
# Without this, gcloud falls back to .gitignore — which doesn't
# exclude *.pth or local analysis caches, ballooning the upload
# from ~800 MB to 5+ GiB and adding ~3 min to every build.
#
# Mirrors .dockerignore's exclusions for the largest local-only
# artifacts. The image's own contents are still controlled by
# .dockerignore at docker-build time.
# ────────────────────────────────────────────────────────────────

# Git
.git
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / Editor
.idea/
.vscode/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs & runtime outputs
*.log
*.jsonl
wandb/
tmp_wandb/
vertex-output/
runs/

# Local analysis artifacts — blanket exclude (analysis/ is 50+ GB locally; eval
# folders accumulate too fast to enumerate per-pattern). Re-include only the
# specific sidecars that training yamls reference at runtime.
analysis/*
!analysis/deeplive_face_geometry_2026-05-05/
analysis/deeplive_face_geometry_2026-05-05/*
!analysis/deeplive_face_geometry_2026-05-05/face_area.parquet
!analysis/cpu_diagnostics_2026-05-09/
analysis/cpu_diagnostics_2026-05-09/*
!analysis/cpu_diagnostics_2026-05-09/slot1_teams_real_keep_list_2026-05-09.csv
!analysis/cpu_diagnostics_2026-05-09/slot2_teams_real_keep_list_2026-05-09.csv
!analysis/cpu_diagnostics_2026-05-09/slot3_teams_real_per_method_keep_list_2026-05-09.csv

# Required by trainer when combined_paired.substrate_paired_inventory.enabled=True
# (data/sources/substrate_paired_inventory.py reads the manifest at iter time)
!analysis/substrate_pair_geometry_2026-05-22/
analysis/substrate_pair_geometry_2026-05-22/*
!analysis/substrate_pair_geometry_2026-05-22/inventory_manifest.csv

# Required by trainer when anchor_aware.enabled=True
# (loss/anchor_aware_penalty.py imports from analysis.teams_pool_rescore)
!analysis/__init__.py
!analysis/teams_pool_rescore.py

*.npz
*.gstmp

# Model weights (loaded from GCS/HuggingFace at runtime)
weights/
*.pt
*.pth
*.ckpt
*.safetensors

# Datasets (loaded from GCS)
dataset/HDTF/
dataset/TalkVid/
dataset/demo_videos_2026-05-14/
dataset/demo_videos_2026-05-14_policy_b.zip
debug/
data_analysis_plots/

# Viewer cache
.viewer_cache/
*.png__thumb224

# Scratch
scratch/

# Offline-packaging artifacts (huge zips, not loaded at runtime)
intel/

# Arena eval outputs (load arena/manifests/, checkpoint_maps/, canaries/ — exclude bulk results)
arena/arena_results/
arena/strategy_results/
arena/visual_audits/

# Inference caches
inference_results/
audit_data/
split_exports/
