# syntax=docker/dockerfile:1
# ────────────────────────────────────────────────────────────────
# Dockerfile.dev - Development/Testing container
# 
# FAST BUILD: Extends the same base image as production!
# Builds in ~30 seconds instead of 10+ minutes.
#
# If requirements.txt changes, rebuild the base image first:
#   gcloud builds submit --config cloudbuild_base_image.yaml --project train-cvit2
# ────────────────────────────────────────────────────────────────
ARG BASE_IMAGE=us-docker.pkg.dev/train-cvit2/effort-detector/effort-detector-base:latest
FROM ${BASE_IMAGE}

# --- Development Environment Overrides ---
ENV DEBUG_MODE=1

# --- Copy code (will be overridden by volume mount in dev) ---
COPY . .

# --- Default command ---
CMD ["bash"]
